    "@types/node": "22",
    "@types/qrcode": "1.5.6",
    "commander": "15.0.0",
    "esbuild-loader": "4.5.0",
    "fflate": "0.8.3",
    "hono": "4.13.13",
    "json5": "2.2.3",
    "jsonc-parser": "3.3.1",
    "license-webpack-plugin": "4.0.2",
    "qrcode": "1.5.4",
    "smol-toml": "1.9.1",
    "tsx": "4.20.6",
    "typescript": "7.0.2",
    "viem": "2.55.10",
