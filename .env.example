# Wallet to run operations on
WALLET_PRIVATE_KEY=

# Chain to sign and default transactions to
ACTIVE_CHAIN_ID=

# API to get actions from; the only origin whose actions the wallet executes
# (https required, except for localhost). Blank uses https://chainhilt.ai/api/v1.
API_BASE_URL=

# RPCs: free public endpoints (rate-limited); use your own provider for
# heavier use. Every chain has a public default; RPC_URL_<chainId> overrides
# any chain (e.g. RPC_URL_42161 for Arbitrum), and blank values fall back to
# that default.
BASE_RPC_URL=https://mainnet.base.org
HYPERLIQUID_RPC_URL=https://rpc.hyperliquid.xyz/evm
POLYGON_RPC_URL=https://polygon.drpc.org

# Testnet RPCs
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
HYPERLIQUID_TESTNET_RPC_URL=https://rpc.hyperliquid-testnet.xyz/evm
