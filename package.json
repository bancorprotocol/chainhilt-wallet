    "prediction",
    "trade",
    "trading",
    "bridge"
  ],
  "homepage": "https://chainhilt.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bancorprotocol/chainhilt-wallet.git"
  },
  "bugs": {
    "url": "https://github.com/bancorprotocol/chainhilt-wallet/issues"
  },
  "license": "Apache-2.0",
  "bin": {
    "chainhilt": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
